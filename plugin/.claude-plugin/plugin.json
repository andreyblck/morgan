{
  "name": "morgan",
  "description": "Engineering discipline for Claude Code: 1 skill, 7 agents, 13 commands. Plan the job, case the joint, pull it clean.",
  "version": "0.2.0",
  "author": {
    "name": "Andrey Black",
    "email": "a.creatuse@gmail.com"
  },
  "license": "MIT",
  "mcpServers": {
    "vault": {
      "command": "node",
      "args": [
        "--disable-warning=ExperimentalWarning",
        "${CLAUDE_PLUGIN_ROOT}/vault/server.mjs"
      ],
      "env": {
        "MORGAN_VAULT_REPO": "${MORGAN_VAULT_REPO:-}",
        "MORGAN_VAULT_DATA": "${MORGAN_VAULT_DATA:-}"
      }
    }
  }
}
